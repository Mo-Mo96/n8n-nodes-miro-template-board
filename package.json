{
    "name": "n8n-nodes-miro-template-board",
    "version": "0.1.0",
    "description": "Copy a Miro template board and fill its frames with workflow data",
    "license": "MIT",
    "homepage": "https://github.com/Mo-Mo96/n8n-nodes-miro-template-board",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "Moataz Mahmoud",
        "email": "131712708+Mo-Mo96@users.noreply.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Mo-Mo96/n8n-nodes-miro-template-board.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/MiroApi.credentials.js",
            "dist/credentials/MiroOAuth2Api.credentials.js"
        ],
        "nodes": [
            "dist/nodes/MiroTemplateBoard/MiroTemplateBoard.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^21.1.0",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }

 
}
